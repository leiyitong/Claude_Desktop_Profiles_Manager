    {{ L"Use letters, digits, spaces, “-”, “_” or “.”.", L"Utiliser des lettres, des chiffres, des espaces, « - », « _ » ou « . ».", L"Buchstaben, Ziffern, Leerzeichen, „-“, „_“ oder „.“ verwenden.", L"Usar letras, números, espacios, «-», «_» o «.».", L"استخدم الحروف أو الأرقام أو المسافات أو «-» أو «_» أو «.».", L"请使用字母、数字、空格、“-”、“_”或“.”。", L"Используйте буквы, цифры, пробелы, «-», «_» или «.».", L"अक्षर, अंक, स्पेस, “-”, “_” या “.” उपयोग करें।", L"Usar letras, dígitos, espaços, “-”, “_” ou “.”.", L"অক্ষর, সংখ্যা, স্পেস, “-”, “_” অথবা “.” ব্যবহার করুন।", L"Gunakan huruf, angka, spasi, “-”, “_” atau “.”.", L"حروف، اعداد، خالی جگہ، “-”، “_” یا “.” استعمال کریں۔" }},
