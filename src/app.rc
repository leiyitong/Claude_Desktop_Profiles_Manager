    CONTROL         "", IDC_C_LIST, "SysListView32", LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 10, 54, 300, 120
    AUTOCHECKBOX    "&Back up .claude first", IDC_C_BACKUP, 10, 180, 300, 10
    LTEXT           "Restore puts them back in the profiles that had them. Delete moves them to the Recycle Bin.", IDC_C_NOTE, 10, 194, 300, 18
