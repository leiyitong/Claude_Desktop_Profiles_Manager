IDD_SIGNIN DIALOGEX 0, 0, 410, 262
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Private sign-in"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_SIGNIN_PROFILE, 10, 10, 390, 12, SS_NOPREFIX
    LTEXT           "Create an account or sign in on Claude's website. To authorize Claude Desktop, first start sign-in in this profile and paste its complete link here. Opening this page alone does not sign in Claude Desktop.", IDC_SIGNIN_HELP, 10, 28, 390, 46, SS_NOPREFIX
    LTEXT           "&Sign-in link:", IDC_SIGNIN_URL_LABEL, 10, 80, 390, 10
    EDITTEXT        IDC_SIGNIN_URL, 10, 94, 390, 14, ES_AUTOHSCROLL
    LTEXT           "&Browser:", IDC_SIGNIN_BROWSER_LABEL, 10, 116, 60, 10
