    LTEXT           "Kept profiles stay in %APPDATA%: a new install finds them again, with default names and colors.", IDC_U_HINT, 10, 154, 272, 18
    DEFPUSHBUTTON   "Uninstall", IDOK, 178, 182, 50, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 232, 182, 50, 15
END


