    LTEXT           "Each opening uses a separate browser folder. The sign-in window's goes once it closes. Edge's and Chrome's stay: close their windows, then use Open browser folders to remove them.", IDC_SIGNIN_CLEANUP, 10, 136, 390, 40, SS_NOPREFIX
    LTEXT           "", IDC_SIGNIN_STATUS, 10, 182, 390, 40, SS_NOPREFIX
    PUSHBUTTON      "Open browser &folders", IDC_SIGNIN_FOLDERS, 10, 237, 124, 15
    DEFPUSHBUTTON   "&Open private browser", IDC_SIGNIN_OPEN, 176, 237, 166, 15
    PUSHBUTTON      "Close", IDCANCEL, 350, 237, 50, 15
END

