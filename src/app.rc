    PUSHBUTTON      L"S&ync settings\x2026", IDC_SYNC, 296, 51, 114, 15
    PUSHBUTTON      L"E&xport\x2026", IDC_BACKUP, 296, 70, 55, 15
    PUSHBUTTON      L"&Import\x2026", IDC_RESTORE_BACKUP, 355, 70, 55, 15
    PUSHBUTTON      "Rep&air", IDC_REPAIR, 296, 89, 114, 15
