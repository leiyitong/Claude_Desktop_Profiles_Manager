#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "version.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_APP ICON "app.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
 PRODUCTVERSION APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Freenitial"
            VALUE "FileDescription", "Claude Desktop Profiles Manager"
            VALUE "FileVersion", APP_VERSION_STR
            VALUE "InternalName", "ClaudeDesktopProfilesManager"
            VALUE "LegalCopyright", "Copyright (c) 2026 Freenitial"
            VALUE "OriginalFilename", "ClaudeDesktopProfilesManager.exe"
            VALUE "ProductName", "Claude Desktop Profiles Manager"
            VALUE "ProductVersion", APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_MAIN DIALOGEX 0, 0, 420, 282
STYLE DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_THICKFRAME | WS_MAXIMIZEBOX | WS_CLIPCHILDREN
CLASS APP_WINDOW_CLASS_NAME
CAPTION "Claude Desktop Profiles Manager"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "&Open", IDC_OPEN, 10, 6, 40, 15
    PUSHBUTTON      "&Quit", IDC_STOP, 54, 6, 40, 15
    PUSHBUTTON      "&Restart", IDC_RESTART, 98, 6, 40, 15
    PUSHBUTTON      L"&New\x2026", IDC_NEW, 148, 6, 40, 15
    PUSHBUTTON      L"&Edit\x2026", IDC_EDIT, 192, 6, 40, 15
    PUSHBUTTON      L"&Delete\x2026", IDC_DELETE, 236, 6, 40, 15
    PUSHBUTTON      "Set as de&fault", IDC_DEFAULT, 286, 6, 60, 15
    PUSHBUTTON      "S&hortcuts", IDC_SHORTCUTS, 348, 6, 18, 15
    PUSHBUTTON      "&Language", IDC_LANGUAGE, 370, 6, 18, 15
    PUSHBUTTON      "Se&ttings", IDC_SETTINGS, 392, 6, 18, 15
    CONTROL         "", IDC_LIST, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 10, 28, 280, 246
    PUSHBUTTON      "Sessions &view", IDC_SESSIONS, 296, 28, 114, 15
    PUSHBUTTON      L"S&ync settings\x2026", IDC_SYNC, 296, 51, 114, 15
    PUSHBUTTON      L"&Backup && Restore\x2026", IDC_BACKUP, 296, 70, 114, 15
    PUSHBUTTON      "Rep&air", IDC_REPAIR, 296, 89, 114, 15
    LTEXT           "", IDC_NOTE, 296, 111, 114, 42, SS_NOPREFIX
    LTEXT           "", IDC_STATUS, 296, 186, 114, 20, SS_NOPREFIX
    CONTROL         "", IDC_PROGRESS, "Static", SS_OWNERDRAW | SS_NOPREFIX | NOT WS_VISIBLE, 296, 191, 114, 15
    PUSHBUTTON      "", IDC_STATUS_ACTION, 296, 210, 114, 15, NOT WS_VISIBLE
    LTEXT           "", IDC_VERSION, 296, 240, 114, 10, SS_NOPREFIX
    PUSHBUTTON      "&Update", IDC_UPDATE, 296, 259, 114, 15, NOT WS_VISIBLE
    LISTBOX         IDC_S_PROFILES, 10, 28, 96, 246, LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | NOT WS_BORDER | NOT WS_VISIBLE
    EDITTEXT        IDC_S_SEARCH, 112, 28, 100, 14, ES_AUTOHSCROLL | NOT WS_VISIBLE
    AUTOCHECKBOX    "Show &archived", IDC_S_ARCHIVED, 216, 30, 64, 10, NOT WS_VISIBLE
    CONTROL         "", IDC_S_TREE, "SysTreeView32", TVS_HASBUTTONS | TVS_LINESATROOT | TVS_SHOWSELALWAYS | TVS_FULLROWSELECT | TVS_NOHSCROLL | TVS_INFOTIP | TVS_NONEVENHEIGHT | TVS_TRACKSELECT | WS_BORDER | WS_TABSTOP | NOT WS_VISIBLE, 112, 46, 178, 228
    CONTROL         "", IDC_S_DETAILS, "Static", SS_OWNERDRAW | SS_NOTIFY | WS_CLIPCHILDREN | NOT WS_VISIBLE, 296, 47, 114, 130
END

IDD_PROFILE DIALOGEX 0, 0, 268, 180
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Profile"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Name:", IDC_P_NAME_LABEL, 10, 13, 40, 10
    EDITTEXT        IDC_P_NAME, 52, 10, 164, 14, ES_AUTOHSCROLL
    LTEXT           "&Color:", IDC_P_COLOR_LABEL, 10, 34, 40, 10
    COMBOBOX        IDC_P_COLOR, 52, 31, 92, 200, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    CONTROL         "", IDC_P_PREVIEW, "Static", SS_ICON | SS_CENTERIMAGE | SS_REALSIZEIMAGE, 226, 8, 32, 32
    LTEXT           "&Badge:", IDC_P_BADGE_LABEL, 10, 55, 40, 10
    EDITTEXT        IDC_P_BADGE, 52, 52, 30, 14, ES_AUTOHSCROLL
    PUSHBUTTON      L"Choose &picture\x2026", IDC_P_PICTURE, 88, 52, 80, 14
    PUSHBUTTON      "Re&move picture", IDC_P_NO_PICTURE, 172, 52, 72, 14
    LTEXT           "S&ync:", IDC_P_SYNC_LABEL, 10, 76, 40, 10
    COMBOBOX        IDC_P_SYNC, 52, 73, 132, 200, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      L"Wha&t to sync\x2026", IDC_P_SYNC_ITEMS, 188, 72, 70, 14
    LTEXT           "", IDC_P_FOLDER, 10, 92, 248, 18, SS_NOPREFIX
    LTEXT           "", IDC_P_ERROR, 10, 92, 248, 18, SS_NOPREFIX | NOT WS_VISIBLE
    AUTOCHECKBOX    "Open at &Windows sign-in", IDC_P_STARTUP, 10, 114, 200, 10
    AUTOCHECKBOX    "", IDC_P_COPY, 10, 127, 248, 10
    AUTOCHECKBOX    "&Open it now to sign in", IDC_P_OPEN, 10, 140, 140, 10
    DEFPUSHBUTTON   "OK", IDOK, 154, 158, 50, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 208, 158, 50, 15
END

