    PUSHBUTTON      L"E&xport sessions\x2026", IDC_H_EXPORT, 10, 62, 121, 15
    PUSHBUTTON      L"&Import sessions\x2026", IDC_H_IMPORT, 137, 62, 121, 15
    PUSHBUTTON      L"Reco&ver sessions\x2026", IDC_H_RECOVER, 10, 81, 121, 15
    PUSHBUTTON      L"C&lean up sessions\x2026", IDC_H_PURGE, 137, 81, 121, 15
