IDD_SHIELD DIALOGEX 0, 0, 500, 266
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Shield"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_H_STATE, 10, 10, 230, 20, SS_NOPREFIX
    AUTOCHECKBOX    "Turn the shield &on", IDC_H_ENABLE, 10, 34, 150, 10
    PUSHBUTTON      L"Check &now", IDC_H_RECHECK, 180, 32, 60, 14
    LTEXT           "", IDC_H_EXIT, 10, 52, 230, 22, SS_NOPREFIX
    LTEXT           "", IDC_H_FACTS, 10, 76, 230, 124, SS_NOPREFIX
    LTEXT           "", IDC_H_AVAIL, 10, 204, 230, 20, SS_NOPREFIX
    LTEXT           "End Claude when the exit breaks a rule:", IDC_H_RULES, 256, 10, 234, 10
    AUTOCHECKBOX    "is a &datacenter IP (not a home connection)", IDC_H_NO_DC, 256, 24, 234, 10
    AUTOCHECKBOX    "&leaks DNS to another region", IDC_H_NO_DNS, 256, 37, 234, 10
    AUTOCHECKBOX    "leaks &UDP by another IP (WebRTC)", IDC_H_NO_UDP, 256, 50, 234, 10
    AUTOCHECKBOX    "has a public IP&v6 that could leak", IDC_H_NO_IPV6, 256, 63, 234, 10
    AUTOCHECKBOX    "has no &tunnel adapter up", IDC_H_STOP_TUN, 256, 76, 234, 10
    AUTOCHECKBOX    "has no &proxy app running", IDC_H_STOP_PROXY, 256, 89, 234, 10
    AUTOCHECKBOX    "cannot be &read (offline or blocked)", IDC_H_STOP_UNKNOWN, 256, 102, 234, 10
    LTEXT           "is below trust &score:", IDC_H_SCORE_LABEL, 256, 119, 90, 10
    EDITTEXT        IDC_H_SCORE, 348, 116, 30, 14, ES_NUMBER | ES_AUTOHSCROLL
    AUTOCHECKBOX    "Only &warn; do not end Claude", IDC_H_WARN, 256, 135, 234, 10
    LTEXT           "Pro&file:", IDC_H_PROFILE_LABEL, 256, 154, 40, 10
    COMBOBOX        IDC_H_PROFILE, 298, 151, 192, 200, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "only from re&gions:", IDC_H_REGIONS_LABEL, 256, 172, 80, 10
    EDITTEXT        IDC_H_REGIONS, 338, 169, 152, 14, ES_AUTOHSCROLL
    LTEXT           "Recent events:", IDC_H_LOG_LABEL, 256, 190, 234, 10
    EDITTEXT        IDC_H_LOG, 256, 202, 234, 38, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | NOT WS_TABSTOP
    DEFPUSHBUTTON   "Close", IDOK, 440, 245, 50, 15
END

