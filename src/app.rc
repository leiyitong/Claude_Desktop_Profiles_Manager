    PUSHBUTTON      "Select &all", IDC_B_ALL, 10, 218, 54, 15
    PUSHBUTTON      "Select &none", IDC_B_NONE, 68, 218, 54, 15
    PUSHBUTTON      "&Invert", IDC_B_INVERT, 126, 218, 54, 15
