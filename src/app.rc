#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "version.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_APP ICON "app.ico"
1 RT_MANIFEST "app.manifest"

// The changelogs, shown from Settings (tools/changelog.py keeps them in a form the program reads).
IDR_CHANGELOG_EN RCDATA "..\\CHANGELOG.md"
IDR_CHANGELOG_ZH RCDATA "..\\CHANGELOG.zh-CN.md"

// windows-mcp-delta's source, zipped by build.cmd before the resources are compiled, extracted and run by uvx.
IDR_WINDOWS_MCP_DELTA RCDATA "..\\build\\windows-mcp-delta.zip"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
 PRODUCTVERSION APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Freenitial"
            VALUE "FileDescription", "Claude Delta"
            VALUE "FileVersion", APP_VERSION_STR
            VALUE "InternalName", "ClaudeDesktopProfilesManager"
            VALUE "LegalCopyright", "Copyright (c) 2026 Freenitial"
            VALUE "OriginalFilename", "ClaudeDesktopProfilesManager.exe"
            VALUE "ProductName", "Claude Delta"
            VALUE "ProductVersion", APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_MAIN DIALOGEX 0, 0, 420, 282
