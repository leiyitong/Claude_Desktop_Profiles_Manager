#include <windows.h>
#include <commctrl.h>
#include "vaulttools.h"
IDD_VAULT_PICK DIALOGEX 0, 0, 390, 270
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Recover selected sessions"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT "", IDC_VAULT_NOTE, 10, 10, 370, 38
    LTEXT "&Search:", -1, 10, 56, 42, 10
    EDITTEXT IDC_VAULT_QUERY, 56, 53, 324, 14, ES_AUTOHSCROLL
    CONTROL "", IDC_VAULT_ROWS, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 10, 74, 370, 156
    LTEXT "", IDC_VAULT_COUNT, 10, 232, 370, 10
    AUTOCHECKBOX "Select &all shown", IDC_VAULT_ALL, 10, 244, 150, 12
    DEFPUSHBUTTON "&Recover", IDOK, 250, 243, 62, 17
    PUSHBUTTON "Cancel", IDCANCEL, 318, 243, 62, 17
END
IDD_PURGE_OPEN DIALOGEX 0, 0, 300, 130
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Open local conversations"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT "", IDC_PURGE_EXPLAIN, 10, 10, 280, 47
    LTEXT "&Profile:", -1, 10, 69, 46, 10
    COMBOBOX IDC_PURGE_TARGET, 58, 66, 232, 100, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "&Open", IDOK, 160, 104, 62, 17
    PUSHBUTTON "Cancel", IDCANCEL, 228, 104, 62, 17
END
