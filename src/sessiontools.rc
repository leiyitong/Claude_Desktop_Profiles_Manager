#include "sessiontools.h"
IDD_SESSIONTOOLS DIALOGEX 0, 0, 580, 360
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Session details"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_ST_NOTE, 10, 9, 560, 25
    EDITTEXT IDC_ST_FILTER, 10, 38, 560, 15, ES_AUTOHSCROLL
    LISTBOX IDC_ST_LIST, 10, 60, 205, 260, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    EDITTEXT IDC_ST_DETAIL, 223, 60, 347, 260, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Open link\x2026", IDC_ST_OPEN, 10, 333, 110, 17
    PUSHBUTTON "Preview", IDC_ST_PREVIEW, 130, 333, 100, 17
    PUSHBUTTON "Export reading copy\x2026", IDC_ST_EXPORT, 240, 333, 140, 17
    DEFPUSHBUTTON "Close", IDCANCEL, 495, 333, 75, 17
END
IDD_SESSIONFILTER DIALOGEX 0, 0, 310, 108
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Execution filters"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Model:", IDC_ST_MODEL_LABEL, 10, 12, 65, 12
    COMBOBOX IDC_ST_MODEL, 80, 10, 220, 130, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT "Effort:", IDC_ST_EFFORT_LABEL, 10, 42, 65, 12
    COMBOBOX IDC_ST_EFFORT, 80, 40, 220, 110, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Apply", IDOK, 140, 81, 75, 17
    PUSHBUTTON "Cancel", IDCANCEL, 225, 81, 75, 17
END

IDD_SESSIONSEARCH DIALOGEX 0, 0, 440, 280
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Search all profiles"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_X_TEXT, 10, 10, 420, 22, SS_NOPREFIX
    CONTROL "", IDC_X_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 10, 38, 420, 170
    LTEXT "Open in:", IDC_X_LABEL, 10, 218, 70, 12
    COMBOBOX IDC_X_PROFILE, 82, 215, 150, 120, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_X_NOTE, 10, 235, 420, 16
    PUSHBUTTON "First matching message\x2026", IDC_ST_HIT, 10, 257, 180, 17
    DEFPUSHBUTTON "Open", IDOK, 270, 257, 75, 17
    PUSHBUTTON "Close", IDCANCEL, 355, 257, 75, 17
END
