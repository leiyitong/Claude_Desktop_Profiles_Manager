#include "profiletools.h"
IDD_PROFILE_TOOLS DIALOGEX 0, 0, 350, 224
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Local profile tools"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT "Selected profile", -1, 10, 12, 105, 10
    COMBOBOX IDC_PT_PROFILE, 120, 9, 220, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Usage history", IDC_PT_USAGE, 10, 38, 160, 17
    PUSHBUTTON "Configuration snapshots", IDC_PT_SNAPSHOTS, 180, 38, 160, 17
    PUSHBUTTON "Data health and differences", IDC_PT_HEALTH, 10, 65, 160, 17
    PUSHBUTTON "Storage and backup estimate", IDC_PT_SPACE, 180, 65, 160, 17
    PUSHBUTTON "Export manager configuration", IDC_PT_EXPORT, 10, 92, 160, 17
    PUSHBUTTON "Import manager configuration", IDC_PT_IMPORT, 180, 92, 160, 17
    PUSHBUTTON "Recent operation results", IDC_PT_HISTORY, 10, 119, 330, 17
    LTEXT "Usage and snapshots use the selected profile. Health, storage and manager configuration cover all listed profiles. Reports stay local and can contain names, IDs and paths.", IDC_PT_NOTE, 10, 148, 330, 40, SS_NOPREFIX
    PUSHBUTTON "Close", IDCANCEL, 290, 199, 50, 15
END
IDD_PT_PROGRESS DIALOGEX 0, 0, 320, 84
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Reading local data"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT "Reading files in the background. You can cancel this scan.", IDC_PT_PROGRESS_TEXT, 10, 12, 300, 30
    PUSHBUTTON "Cancel", IDCANCEL, 260, 59, 50, 15
END
IDD_PT_MAPPING DIALOGEX 0, 0, 350, 136
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Map imported profile"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT "", IDC_PT_MAP_NOTE, 10, 10, 330, 52, SS_NOPREFIX
    COMBOBOX IDC_PT_MAP_TARGET, 10, 70, 330, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Continue", IDOK, 228, 111, 56, 15
    PUSHBUTTON "Cancel", IDCANCEL, 290, 111, 50, 15
END
IDD_PT_SNAPSHOTS DIALOGEX 0, 0, 460, 258
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Configuration snapshots"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT "The latest 16 snapshots contain window geometry and allowDevTools only. Login, MCP, paths and unknown fields are excluded. Filenames use UTC. Missing source files do not request deletion.", IDC_PT_SNAPSHOT_NOTE, 10, 10, 440, 35, SS_NOPREFIX
    LISTBOX IDC_PT_SNAPSHOT_LIST, 10, 53, 440, 161, LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON "Take snapshot", IDC_PT_SNAPSHOT_CREATE, 10, 233, 90, 15
    PUSHBUTTON "Restore selected", IDC_PT_SNAPSHOT_RESTORE, 110, 233, 98, 15
    PUSHBUTTON "Close", IDCANCEL, 400, 233, 50, 15
END
